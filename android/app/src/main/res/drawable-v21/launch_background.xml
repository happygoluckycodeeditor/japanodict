<?xml version="1.0" encoding="utf-8"?>
<!-- The window Android draws while the process starts, before Flutter's first
     frame. The logo tile has transparent corners, so it sits correctly on both
     the light and the dark background this resolves to. splash_logo.png is
     generated by scripts/build_app_icons.py. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="?android:colorBackground" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
